# Copy to .env; replace placeholders before starting. Never commit .env.
DB_USER=finiq
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATABASE_URL=jdbc:postgresql://localhost:5432/finiq
FRONTEND_URL=http://localhost:5173
ML_URL=http://localhost:8001
# Disabled by default. Use smtp in production; development writes private local files.
RESET_MODE=disabled
RESET_DIRECTORY=.runtime/reset-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional one-time bootstrap; no default admin account is created if blank.
ADMIN_EMAIL=
ADMIN_PASSWORD=
WEB_PORT=8088
COMPOSE_FRONTEND_URL=http://localhost:8088
COMPOSE_RESET_MODE=disabled
